<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve bearer authentication when Apache/FastCGI invokes PHP.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force WWW Canonical Domain (Prevents duplicate content & GSC indexing mismatches)
  RewriteCond %{HTTP_HOST} ^comeagaintoursandtravels\.com$ [NC]
  RewriteRule ^ https://www.comeagaintoursandtravels.com%{REQUEST_URI} [L,R=301]

  # Keep one public URL for each page, including older campaign aliases.
  RewriteRule ^request-a-quote/?$ /contact [L,R=301]
  RewriteRule ^uganda-car-hire/?$ /car-hire-uganda [L,R=301]
  RewriteRule ^custom-safari/?$ /plan-my-trip [L,R=301]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Route the Laravel API and signed newsletter actions before SPA routing.
  RewriteRule ^api(?:/.*)?$ api/index.php [L,QSA]
  RewriteRule ^(?:unsubscribe|resubscribe)$ api/index.php [L,QSA]

  # Serve files directly, then only the routes the React app actually handles.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^(?:destination|services|packages|about|about/vision-mission|about/our-team|gallery|blog|contact|uganda-safaris|bwindi-gorilla-trekking|queen-elizabeth-national-park-safaris|murchison-falls-safaris|kibale-chimpanzee-safaris|uganda-wildlife-safaris|car-hire-uganda|plan-my-trip|gorilla-permits-guide|safari-cost-calculator|best-time-to-visit-uganda)$ /index.html [L]
  RewriteRule ^(?:package|blog|guides)/[^/]+$ /index.html [L]
  RewriteRule ^admin(?:/.*)?$ /index.html [L]
  RewriteRule ^$ /index.html [L]
  RewriteRule . - [R=404,L]
</IfModule>

# LiteSpeed Server: Ensure sitemap, robots.txt, llms.txt, .well-known, and all crawlers/checking tools are NEVER blocked
<IfModule LiteSpeed>
    RewriteEngine On
    # Drop CAPTCHA/bot verification for critical SEO files for ALL visitors & tools
    RewriteCond %{REQUEST_URI} ^/(robots\.txt|.*sitemap.*\.xml|llms\.txt|\.well-known/.*)$ [NC]
    RewriteRule .* - [E=verifycaptcha:drop]

    # Drop CAPTCHA/bot verification for all major search engine, SEO checking tools & AI crawlers
    RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandex|screaming\ frog|applebot|facebookexternalhit|twitterbot|linkedinbot|gptbot|chatgpt-user|claudebot|anthropic-ai|perplexitybot|cohere-ai|google-extended|ahrefsbot|semrushbot|dotbot|rogerbot|seokicks|sitechecker|woorank) [NC]
    RewriteRule .* - [E=verifycaptcha:drop]
</IfModule>

# Allow cross-origin and ensure public access to sitemap, robots.txt, llms.txt
<FilesMatch "^(robots\.txt|.*sitemap.*\.xml|llms\.txt)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=3600"
    </IfModule>
</FilesMatch>

# Force correct MIME types
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/json .json
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Enable Gzip / Deflate compression for all text, code, fonts and SVGs
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml font/ttf font/otf font/woff font/woff2 image/svg+xml
</IfModule>

# Browser Caching Headers (mod_expires & mod_headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML pages: Fresh each load
  ExpiresByType text/html "access plus 0 seconds"
  
  # CSS, JavaScript & Fonts: Cache 1 year (immutable)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  
  # Images: Cache 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Data & Feeds
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # 1 year immutable cache for Vite production bundles and media assets
  <FilesMatch "\.(css|js|woff2|woff|ttf|svg|webp|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Do not cache index.html so code updates apply immediately to users
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Security & MIME sniffing protection
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Secrets, source files and setup utilities must never be public.
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|setup\.php)$">
  Require all denied
</FilesMatch>
